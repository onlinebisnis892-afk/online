{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/data/[entity]",
      "regex": "^/api/data/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPentity": "nxtPentity"
      },
      "namedRegex": "^/api/data/(?<nxtPentity>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/features/[feature]",
      "regex": "^/api/features/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPfeature": "nxtPfeature"
      },
      "namedRegex": "^/api/features/(?<nxtPfeature>[^/]+?)(?:/)?$"
    },
    {
      "page": "/modules/[key]",
      "regex": "^/modules/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPkey": "nxtPkey"
      },
      "namedRegex": "^/modules/(?<nxtPkey>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/feature-checklist",
      "regex": "^/feature\\-checklist(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/feature\\-checklist(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/modules",
      "regex": "^/modules(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/modules(?:/)?$"
    },
    {
      "page": "/modules/reports/employees",
      "regex": "^/modules/reports/employees(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/modules/reports/employees(?:/)?$"
    },
    {
      "page": "/modules/transactions/new",
      "regex": "^/modules/transactions/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/modules/transactions/new(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}