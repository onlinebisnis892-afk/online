import {NextRequest,NextResponse} from 'next/server';import {getSessionUser} from '@/lib/auth';import {csv,reportData} from '@/lib/reports';
export async function GET(r:NextRequest){const u=await getSessionUser();if(!u)return NextResponse.json({message:'Unauthorized'},{status:401});const q=r.nextUrl.searchParams,type=q.get('type')||'transactions';const data=await reportData(type,{from:q.get('from')||undefined,to:q.get('to')||undefined});if(q.get('format')==='csv'){const rows=Array.isArray(data)?data:[data];return new NextResponse(csv(rows),{headers:{'Content-Type':'text/csv; charset=utf-8','Content-Disposition':`attachment; filename=wz-${type}.csv`}})}return NextResponse.json(data)}
