generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { OWNER MANAGER BARBER KASIR }
enum UserStatus { ACTIVE INACTIVE }
enum TxStatus { DRAFT SELESAI VOID }
enum PaymentMethod { CASH QRIS TRANSFER }
enum AttendanceStatus { HADIR TERLAMBAT TIDAK_HADIR IZIN CUTI }

enum ApprovalStatus { PENDING APPROVED REJECTED }

model User { id String @id @default(cuid()); username String @unique; passwordHash String; role Role; status UserStatus @default(ACTIVE); employee Employee?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; sessions Session[]; loginEvents LoginEvent[]; auditLogs AuditLog[]; resetTokens PasswordResetToken[]; preference UserPreference? }
model Session { id String @id @default(cuid()); userId String; tokenHash String @unique; expiresAt DateTime; deviceLabel String?; ip String?; userAgent String?; revokedAt DateTime?; user User @relation(fields:[userId], references:[id], onDelete:Cascade); createdAt DateTime @default(now()); @@index([userId, expiresAt]) }
model Branch { id String @id @default(cuid()); name String; address String?; active Boolean @default(true); target Decimal @default(0); hoursJson Json?; employees Employee[]; services BranchService[]; transactions Transaction[]; expenses Expense[]; cashEntries CashEntry[]; inventory InventoryItem[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Employee { id String @id @default(cuid()); employeeNo String @unique; name String; role Role; active Boolean @default(true); branchId String; userId String? @unique; salary Decimal @default(0); commissionRate Decimal @default(0); target Decimal @default(0); branch Branch @relation(fields:[branchId], references:[id]); user User? @relation(fields:[userId], references:[id]); attendance Attendance[]; shifts Shift[]; transactions Transaction[]; bookings Booking[]; evaluations Evaluation[]; payroll Payroll[]; commissions Commission[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([branchId, active]) }
model Customer { id String @id @default(cuid()); customerNo String @unique; name String; phone String?; tags String?; notes String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; bookings Booking[]; transactions Transaction[] }
model Service { id String @id @default(cuid()); name String; category String; duration Int; active Boolean @default(true); priceHistory ServicePrice[]; branches BranchService[]; transactionItems TransactionItem[]; promoUses PromotionUse[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model BranchService { id String @id @default(cuid()); branchId String; serviceId String; price Decimal; active Boolean @default(true); branch Branch @relation(fields:[branchId], references:[id], onDelete:Cascade); service Service @relation(fields:[serviceId], references:[id], onDelete:Cascade); @@unique([branchId, serviceId]) }
model ServicePrice { id String @id @default(cuid()); serviceId String; price Decimal; effectiveAt DateTime; service Service @relation(fields:[serviceId], references:[id], onDelete:Cascade); @@index([serviceId, effectiveAt]) }
model Promotion { id String @id @default(cuid()); name String; type String; value Decimal; startAt DateTime; endAt DateTime; usageLimit Int?; conditionsJson Json?; active Boolean @default(true); uses PromotionUse[] }
model PromotionUse { id String @id @default(cuid()); promotionId String; serviceId String?; transactionId String; discount Decimal; promotion Promotion @relation(fields:[promotionId], references:[id]); service Service? @relation(fields:[serviceId], references:[id]); transaction Transaction @relation(fields:[transactionId], references:[id]); @@index([promotionId]) }
model Booking { id String @id @default(cuid()); customerId String; employeeId String?; serviceId String; branchId String; scheduledAt DateTime; status String; customer Customer @relation(fields:[customerId], references:[id]); employee Employee? @relation(fields:[employeeId], references:[id]); transaction Transaction?; createdAt DateTime @default(now()); @@index([branchId, scheduledAt]) }
model QueueItem { id String @id @default(cuid()); number Int; customerId String?; bookingId String?; serviceId String?; employeeId String?; branchId String; status String; joinedAt DateTime @default(now()); calledAt DateTime?; startedAt DateTime?; completedAt DateTime? }
model Transaction { id String @id @default(cuid()); number String @unique; branchId String; customerId String?; employeeId String?; bookingId String? @unique; status TxStatus @default(DRAFT); payment PaymentMethod?; subtotal Decimal @default(0); discount Decimal @default(0); total Decimal @default(0); reason String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; branch Branch @relation(fields:[branchId], references:[id]); customer Customer? @relation(fields:[customerId], references:[id]); employee Employee? @relation(fields:[employeeId], references:[id]); booking Booking? @relation(fields:[bookingId], references:[id]); items TransactionItem[]; promotionUses PromotionUse[]; commission Commission? }
model TransactionItem { id String @id @default(cuid()); transactionId String; serviceId String; price Decimal; qty Int @default(1); discount Decimal @default(0); total Decimal; transaction Transaction @relation(fields:[transactionId], references:[id], onDelete:Cascade); service Service @relation(fields:[serviceId], references:[id]); @@index([serviceId]) }
model Expense { id String @id @default(cuid()); branchId String; category String; amount Decimal; reference String?; approval ApprovalStatus @default(PENDING); createdAt DateTime @default(now()); branch Branch @relation(fields:[branchId], references:[id]); }
model Attendance { id String @id @default(cuid()); employeeId String; status AttendanceStatus; checkIn DateTime?; checkOut DateTime?; date DateTime; employee Employee @relation(fields:[employeeId], references:[id]); @@unique([employeeId,date]) }
model Shift { id String @id @default(cuid()); employeeId String; branchId String; startAt DateTime; endAt DateTime?; status String; employee Employee @relation(fields:[employeeId], references:[id]); }
model Commission { id String @id @default(cuid()); employeeId String; transactionId String @unique; amount Decimal; status String; employee Employee @relation(fields:[employeeId], references:[id]); transaction Transaction @relation(fields:[transactionId], references:[id]); }
model Payroll { id String @id @default(cuid()); employeeId String; periodStart DateTime; periodEnd DateTime; base Decimal; commission Decimal; deduction Decimal @default(0); net Decimal; status ApprovalStatus @default(PENDING); employee Employee @relation(fields:[employeeId], references:[id]); }
model Evaluation { id String @id @default(cuid()); employeeId String; score Decimal; notes String?; date DateTime @default(now()); employee Employee @relation(fields:[employeeId], references:[id]); }
model Notification { id String @id @default(cuid()); userId String?; title String; message String; priority String; readAt DateTime?; createdAt DateTime @default(now()); }
model AuditLog { id String @id @default(cuid()); userId String?; action String; entity String?; entityId String?; details Json?; createdAt DateTime @default(now()); user User? @relation(fields:[userId], references:[id]); @@index([createdAt]) }
model LoginEvent { id String @id @default(cuid()); userId String?; username String; success Boolean; ip String?; userAgent String?; createdAt DateTime @default(now()); user User? @relation(fields:[userId], references:[id]); }
model ExportLog { id String @id @default(cuid()); userId String?; reportType String; format String; createdAt DateTime @default(now()); }
model BackupLog { id String @id @default(cuid()); type String; location String?; createdAt DateTime @default(now()); }
model SystemEvent { id String @id @default(cuid()); kind String; severity String; message String; createdAt DateTime @default(now()); }

model PasswordResetToken { id String @id @default(cuid()); userId String; tokenHash String @unique; expiresAt DateTime; deviceLabel String?; ip String?; userAgent String?; usedAt DateTime?; user User @relation(fields:[userId], references:[id], onDelete:Cascade); @@index([userId, expiresAt]) }
model Permission { id String @id @default(cuid()); key String @unique; label String; rolePermissions RolePermission[] }
model RolePermission { id String @id @default(cuid()); role Role; permissionId String; permission Permission @relation(fields:[permissionId], references:[id], onDelete:Cascade); @@unique([role,permissionId]) }
model UserPreference { id String @id @default(cuid()); userId String @unique; notificationJson Json?; systemJson Json?; user User @relation(fields:[userId], references:[id], onDelete:Cascade) }
model CashEntry { id String @id @default(cuid()); branchId String; type String; amount Decimal; category String; reference String?; createdAt DateTime @default(now()); branch Branch @relation(fields:[branchId], references:[id]); @@index([branchId, createdAt]) }
model PeriodLock { id String @id @default(cuid()); branchId String?; startAt DateTime; endAt DateTime; status String; lockedBy String?; reopenedBy String?; createdAt DateTime @default(now()); @@index([branchId, startAt, endAt]) }
model InventoryItem { id String @id @default(cuid()); branchId String; name String; sku String?; stock Int @default(0); minStock Int @default(0); unitPrice Decimal @default(0); active Boolean @default(true); branch Branch @relation(fields:[branchId], references:[id]); movements StockMovement[]; @@index([branchId, active]) }
model StockMovement { id String @id @default(cuid()); inventoryItemId String; type String; qty Int; reason String?; createdAt DateTime @default(now()); item InventoryItem @relation(fields:[inventoryItemId], references:[id], onDelete:Cascade); @@index([inventoryItemId, createdAt]) }
model ReportSchedule { id String @id @default(cuid()); userId String; reportType String; format String; frequency String; nextRunAt DateTime; active Boolean @default(true); createdAt DateTime @default(now()); }
model NotificationPreference { id String @id @default(cuid()); userId String @unique; enabled Boolean @default(true); categories Json?; quietStart String?; quietEnd String? }
